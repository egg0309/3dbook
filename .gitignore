# ===== 依赖目录（匹配任意层级）=====
node_modules/
.venv/
venv/
env/
__pypackages__/

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ===== 环境变量与密钥（.example 模板除外）=====
.env
.env.*
!.env.example

# ===== 构建产物 =====
dist/
dist-ssr/
build/
*.local

# ===== 日志 =====
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== 编辑器 / 操作系统 =====
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.sw?
