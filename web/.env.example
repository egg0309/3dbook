# 复制为 .env.local 后按需要修改（.env.local 不会提交）
# mock = 使用前端内置的三关演示数据
# live = 调用真实后端接口
VITE_AGENT_MODE=mock

# 智能体接口路径；同源部署时保持 /api/chat，
# 跨域部署（如 Vercel 前端 + Render 后端）填后端完整地址：
# https://<your-app>.onrender.com/api/chat
VITE_AGENT_API_URL=/api/chat

# 请求超时（毫秒）；Serverless 免费层冷启动慢，生产环境建议 30000
VITE_AGENT_TIMEOUT_MS=12000

# 仅开发/预览服务器生效：把 /api 代理到后端
VITE_AGENT_PROXY_TARGET=http://127.0.0.1:8000
